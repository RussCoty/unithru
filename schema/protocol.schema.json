        "status": {
          "const": "ok"
        },
        "body": {
          "type": "object",
          "properties": {
            "device_id": {
              "$ref": "#/$defs/id"
            },
            "session_id": {
              "$ref": "#/$defs/id"
            },
            "capabilities": {
              "$ref": "#/$defs/capabilities"
            }
          },
          "required": [
            "device_id",
            "session_id",
            "capabilities"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "request_id",
        "op",
        "epoch",
        "revision",
        "status",
        "body"
      ],
