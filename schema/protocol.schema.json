                "$ref": "#/$defs/id"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "client_id": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "versions",
            "client_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "request_id",
        "op",
        "body"
      ],
      "additionalProperties": false
    },
