{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UniThru 0.1 core envelopes",
  "description": "Draft shape validation; semantic constraints also apply. See spec/core-v0.1.md.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "route": {
      "type": "object",
      "properties": {
        "route_id": {
          "$ref": "#/$defs/id"
        },
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "destination_id": {
          "$ref": "#/$defs/id"
        },
        "enabled": {
          "type": "boolean"
        },
        "gain_db": {
          "type": "number"
        },
        "pan": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "pan_law": {
          "$ref": "#/$defs/id"
        },
        "owner_session": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "lease_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "route_revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "route_id",
        "source_id",
        "destination_id",
        "enabled",
        "gain_db",
        "pan",
        "pan_law",
        "owner_session",
        "lease_id",
        "route_revision"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "versions": {
          "type": "array",
          "items": {
            "const": "0.1"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string"
              },
              "channels": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "minItems": 1,
                "maxItems": 2,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "label",
              "channels"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "destinations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string"
              },
              "channels": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "minItems": 1,
                "maxItems": 2,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "label",
              "channels"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "topologies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "source_channels": {
                "enum": [
                  1,
                  2
                ]
              },
              "destination_channels": {
                "enum": [
                  1,
                  2
                ]
              },
              "pan_law": {
                "$ref": "#/$defs/id"
              }
            },
            "required": [
              "source_channels",
              "destination_channels",
              "pan_law"
            ],
            "additionalProperties": false
          }
        },
        "gain_db": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "min",
            "max",
            "step"
          ],
          "additionalProperties": false
        },
        "max_routes": {
          "type": "integer",
          "minimum": 1
        },
        "max_leases": {
          "type": "integer",
          "minimum": 1
        },
        "lease_ms": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "max_message_bytes": {
          "type": "integer",
          "minimum": 512,
          "maximum": 8192
        },
        "max_requests_per_session": {
          "type": "integer",
          "minimum": 1
        },
        "poll_interval_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "operation_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "readback": {
          "const": "verified"
        },
        "atomic_batch": {
          "const": false
        },
        "timing": {
          "const": "immediate"
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "$ref": "#/$defs/id"
              },
              "version": {
                "$ref": "#/$defs/id"
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "required": [
        "versions",
        "sources",
        "destinations",
        "topologies",
        "gain_db",
        "max_routes",
        "max_leases",
        "lease_ms",
        "max_message_bytes",
        "max_requests_per_session",
        "poll_interval_ms",
        "operation_timeout_ms",
        "readback",
        "atomic_batch",
        "timing",
        "extensions"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": {
          "const": "0.1"
        },
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "op": {
          "const": "hello"
        },
        "body": {
          "type": "object",
